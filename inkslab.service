[Unit]
Description=InkSlab - e-Ink TCG Card Display
After=network-online.target NetworkManager.service
Wants=network-online.target NetworkManager.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=root
ExecStartPre=/bin/bash /home/pi/inkslab/scripts/selfheal.sh
ExecStart=/usr/bin/python3 -u /home/pi/inkslab/inkslab.py
WorkingDirectory=/home/pi/inkslab
Restart=on-failure
RestartSec=30
# Crash loop guard: give up after 5 failures in 10 minutes.
# selfheal.sh will repair on the next manual reboot.
# Display sleep takes up to ~30s; give the finally-block time to finish.
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
