[Unit]
Description=InkSlab Web Dashboard
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 -u /home/pi/inkslab/inkslab_web.py
WorkingDirectory=/home/pi/inkslab
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
