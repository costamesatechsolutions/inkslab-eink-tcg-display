[Unit]
Description=InkSlab Web Dashboard
After=network-online.target NetworkManager.service inkslab.service
Wants=network-online.target NetworkManager.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 -u /home/pi/inkslab/inkslab_web.py
WorkingDirectory=/home/pi/inkslab
Restart=on-failure
RestartSec=10
# Crash loop guard: give up after 5 failures in 10 minutes.
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
