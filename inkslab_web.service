[Unit]
Description=InkSlab Web Dashboard
After=network-online.target NetworkManager.service
Wants=network-online.target NetworkManager.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 -u /home/pi/inkslab/inkslab_web.py
WorkingDirectory=/home/pi/inkslab
Restart=always
RestartSec=10
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
